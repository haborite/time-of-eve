# Copy to .dev.vars for local development (never commit .dev.vars).
# 32+ random bytes, e.g. `openssl rand -hex 32`
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
# Cloudflare Turnstile test secret (always passes). Use the real one in staging/production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
