{
  // Browser code (bundled by esbuild into public/static/js/*.js). Checked separately from the Worker: DOM types here,
  // Workers types there. Code shared with the Worker lives in src/shared and is pulled in by import.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  "include": ["./**/*.ts"]
}
