{
  // Browser code (bundled by esbuild into public/static/*.js). Checked separately from the Worker: DOM types here,
  // Workers types there. Shared modules (src/lib/i18n-format.ts, src/lib/time.ts, src/shared) are pulled in by import.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  "include": ["./**/*.ts"]
}
